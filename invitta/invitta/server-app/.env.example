# Supabase → Project Settings → Database → Connection string.
# Local Postgres works too: postgres://postgres:postgres@localhost:5432/invitta
# For the Supabase transaction pooler (port 6543) set DATABASE_PREPARE=false.
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DATABASE_PREPARE=true

# Signs the session cookie. Generate one with: openssl rand -base64 32
AUTH_SECRET=change-me-to-a-long-random-string

# Optional: account created by `pnpm db:seed-user` (defaults: admin@invitta.ro / admin12345).
SEED_EMAIL=admin@invitta.ro
SEED_PASSWORD=admin12345
SEED_NAME=Admin
